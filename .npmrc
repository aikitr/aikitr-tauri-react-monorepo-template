# 自动安装缺失的 peer 依赖
auto-install-peers=true

# 关闭严格 peer 检查（部分生态包 peer 版本尚未对齐到最新）
strict-peer-dependencies=false

# isolated（默认）保留严格隔离，复制到各包 node_modules 避免 Windows 符号链接权限问题
node-linker=isolated

# Windows 上符号链接需管理员权限，改用 copy 更稳定
package-import-method=copy

# 自定义 .pnpm-patches 目录（预留）
patches-dir=patches
