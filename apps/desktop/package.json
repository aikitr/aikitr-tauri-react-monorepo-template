{
  "name": "@aikitr-desktop/app-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tauri v2 + React 19 desktop application",
  "scripts": {
    "dev": "tauri dev",
    "dev:frontend": "vite",
    "build": "tauri build",
    "build:frontend": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src vite.config.ts --max-warnings 0",
    "test": "vitest run --config ../../vitest.config.ts --project desktop",
    "test:watch": "vitest --config ../../vitest.config.ts --project desktop",
    "clean": "rimraf dist src-tauri/target",
    "tauri": "tauri"
  },
  "dependencies": {
    "@aikitr-desktop/types": "workspace:^",
    "@aikitr-desktop/utils": "workspace:^",
    "@aikitr-desktop/icons": "workspace:^",
    "@aikitr-desktop/ui": "workspace:^",
    "@aikitr-desktop/api": "workspace:^",
    "@aikitr-desktop/auth": "workspace:^",
    "@tauri-apps/api": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@aikitr-desktop/config": "workspace:^",
    "@tailwindcss/vite": "catalog:",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^22.20.5",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "^30.1.1",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
