{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "types": [],
    "paths": {
      "@aikitr-desktop/types": ["../../types/src"],
      "@aikitr-desktop/api": ["../../api/src"],
      "@aikitr-desktop/utils": ["../../utils/src"]
