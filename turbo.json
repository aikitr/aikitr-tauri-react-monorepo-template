{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "envMode": "strict",
  "globalDependencies": [
    ".env",
    ".env.local",
    ".env.*.local",
    ".env.development",
    ".env.production",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    ".npmrc",
    "tsconfig.json",
    "eslint.config.mjs",
    "packages/config/eslint.mjs",
    ".cargo/config.toml"
  ],
  "globalEnv": ["NODE_ENV", "DEBUG", "CI", "TAURI_ENVIRONMENT", "VITE_*"],
  "tasks": {
    "build": {
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/*/tsconfig.json",
        "$TURBO_ROOT$/packages/*/components.json"
      ],
      "env": ["VITE_*", "TAURI_ENVIRONMENT"],
      "passThroughEnv": ["CARGO_*", "RUST*", "TAURI_SIGNING_*", "TAURI_ENV_*"]
    },
    "type-check": {
      "dependsOn": ["^type-check"],
      "outputs": [],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/*/tsconfig.json",
        "$TURBO_ROOT$/packages/*/components.json"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["CARGO_*", "RUST*", "TAURI_SIGNING_*", "TAURI_ENV_*"]
    },
    "dev:frontend": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [],
      "outputs": [],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/*/tsconfig.json",
        "$TURBO_ROOT$/packages/*/components.json"
      ]
    },
    "test": {
      "dependsOn": [],
      "outputs": ["coverage/**", ".turbo/test-results/**"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/*/tsconfig.json",
        "$TURBO_ROOT$/packages/*/components.json",
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_ROOT$/tests/setup-dom.ts"
      ]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "build:frontend": {
      "dependsOn": [],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/*/tsconfig.json",
        "$TURBO_ROOT$/packages/*/components.json"
      ],
      "env": ["VITE_*"]
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "tauri": {
      "cache": false
    },
    "format": {
      "cache": false
    }
  },
  "globalPassThroughEnv": ["TAURI_DEV_HOST"]
}
